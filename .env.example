# Load explicitly: node --env-file=.env hl-markets.mjs --market perp
# The CLI defaults to mainnet when HL_NETWORK is unset.
HL_NETWORK=testnet

# Actual trading account address for hl-account, not the API wallet address.
# Public market data works without this value.
HL_ACCOUNT=

# Needed only to submit live exchange actions; preferably an approved API wallet.
# Read-only commands and --dry-run do not need a signing key.
# Keep this file private and out of version control.
HL_PRIVATE_KEY=

# Optional vault/subaccount target for exchange actions and account reads.
HL_VAULT_ADDRESS=
